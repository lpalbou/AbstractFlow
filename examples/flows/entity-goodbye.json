    {
      "id": "chat_state",
      "type": "code",
      "position": {
        "x": 400,
        "y": 100
      },
      "data": {
        "nodeType": "code",
        "label": "Session history folds",
        "icon": "&#x1F9E9;",
        "headerColor": "#9B59B6",
        "inputs": [
          {
            "id": "state",
            "label": "state",
            "type": "object"
          },
          {
            "id": "context",
            "label": "context",
            "type": "object"
          },
          {
            "id": "permissions",
            "label": "permissions",
            "type": "string"
          }
        ],
        "outputs": [
          {
            "id": "output",
            "label": "output",
            "type": "object"
          },
          {
            "id": "success",
            "label": "success",
            "type": "boolean"
          },
          {
            "id": "execution",
            "label": "execution",
            "type": "object"
          }
        ],
        "pinDefaults": {
          "permissions": "sandbox"
        },
        "functionName": "transform",
        "codeBody": "\n# Session continuity for chat clients: when the host seeds durable session\n# history (use_session_history -> context.messages), fold the replayed turns\n# into the session log so the shelf's THIS-SESSION block carries the live\n# conversation — without this every chat prompt was an amnesiac turn and\n# only graph recall bridged prompts (adversary F6).\nstate = _input.get(\"state\")\nif not isinstance(state, dict):\n    state = {}\nstate = dict(state)\nlog = state.get(\"turn_log\")\nif not isinstance(log, list):\n    log = []\nif not log:\n    ctx = _input.get(\"context\")\n    if not isinstance(ctx, dict):\n        ctx = {}\n    msgs = ctx.get(\"messages\")\n    if not isinstance(msgs, list):\n        msgs = []\n    pending_user = \"\"\n    folded = []\n    # Every replayed message: the host already applied THE history window\n    # (the most recent 50,000 tokens of whole turns, recorded in the run;\n    # abstractruntime.session_history). No second, smaller bound here.\n    for m in msgs:\n        if not isinstance(m, dict):\n            continue\n        role = str(m.get(\"role\") or \"\")\n        content = str(m.get(\"content\") or \"\")\n        if role == \"user\":\n            pending_user = content\n        elif role == \"assistant\" and pending_user:\n            folded.append({\"stimulus\": pending_user, \"reply\": content})\n            pending_user = \"\"\n    if folded:\n        log = folded\n        state[\"turn_log\"] = log\nreturn {\"state\": state}\n",
        "pinExpressions": {
          "context": "vars.get(\"context\", {})"
        }
      },
      "label": null,
      "icon": null,
      "headerColor": null,
      "inputs": [],
