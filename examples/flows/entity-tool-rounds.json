      },
      "data": {
        "nodeType": "code",
        "label": "The moment resolves in words",
        "icon": "&#x1F9E9;",
        "headerColor": "#9B59B6",
        "inputs": [
          {
            "id": "state",
            "label": "state",
            "type": "object"
          },
          {
            "id": "reply",
            "label": "reply",
            "type": "string"
          },
          {
            "id": "permissions",
            "label": "permissions",
            "type": "string"
          }
        ],
        "outputs": [
          {
            "id": "output",
            "label": "output",
            "type": "object"
          },
          {
            "id": "success",
            "label": "success",
            "type": "boolean"
          },
          {
            "id": "execution",
            "label": "execution",
            "type": "object"
          }
        ],
        "pinDefaults": {
          "permissions": "sandbox"
        },
        "functionName": "transform",
        "codeBody": "\n# The moment resolved into words: keep the reply, close the loop.\ns = _input.get(\"state\")\nif not isinstance(s, dict):\n    s = {}\nreply = str(_input.get(\"reply\") or \"\")\nprev = s.get(\"ran\")\nif not isinstance(prev, list):\n    prev = []\nwords = s.get(\"words\")\nif not isinstance(words, list):\n    words = []\nreturn {\"state\": {\"prompt\": str(s.get(\"prompt\") or \"\"),\n                  \"rounds_used\": int(s.get(\"rounds_used\") or 0),\n                  \"ran\": prev, \"words\": words,\n                  \"calls_used\": int(s.get(\"calls_used\") or 0),\n                  \"done\": True, \"reply\": reply}}\n"
      },
      "label": null,
      "icon": null,
      "headerColor": null,
      "inputs": [],
      "outputs": []
    },
