      },
      "data": {
        "nodeType": "code",
        "label": "The rounds report",
        "icon": "&#x1F9E9;",
        "headerColor": "#9B59B6",
        "inputs": [
          {
            "id": "state",
            "label": "state",
            "type": "object"
          },
          {
            "id": "permissions",
            "label": "permissions",
            "type": "string"
          }
        ],
        "outputs": [
          {
            "id": "output",
            "label": "output",
            "type": "object"
          },
          {
            "id": "success",
            "label": "success",
            "type": "boolean"
          },
          {
            "id": "execution",
            "label": "execution",
            "type": "object"
          }
        ],
        "pinDefaults": {
          "permissions": "sandbox"
        },
        "functionName": "transform",
        "codeBody": "\n# The subflow's honest output: the final words + the host-authored gauge\n# (tools_ran comes from executed batches only — never parsed from prose).\n# prior_words carries the mind's own mid-round prose so the turn's election\n# parse and episode see the WHOLE lived moment (fix adversary P1-1); silent\n# marks a moment that ended without words (fix adversary P1-2 — the visit\n# layer surfaces it as degraded, never a quiet empty answer).\ns = _input.get(\"state\")\nif not isinstance(s, dict):\n    s = {}\nran = s.get(\"ran\")\nif not isinstance(ran, list):\n    ran = []\nwords = s.get(\"words\")\nif not isinstance(words, list):\n    words = []\nreply = str(s.get(\"reply\") or \"\")\nsilent = 1 if (bool(s.get(\"done\")) and not reply.strip()) else 0\nreturn {\"reply\": reply, \"tools_ran\": ran,\n        \"rounds_used\": int(s.get(\"rounds_used\") or 0),\n        \"prior_words\": \"\\n\".join(words), \"silent\": silent}\n"
      },
      "label": null,
      "icon": null,
      "headerColor": null,
      "inputs": [],
      "outputs": []
    },
