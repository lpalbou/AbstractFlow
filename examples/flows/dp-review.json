    {
      "id": "derive_settings",
      "type": "code",
      "position": {
        "x": -700,
        "y": -160
      },
      "data": {
        "nodeType": "code",
        "label": "Derive effort settings",
        "icon": "&#x25A1;",
        "headerColor": "#3498DB",
        "inputs": [
          {
            "id": "exec-in",
            "label": "",
            "type": "execution"
          },
          {
            "id": "effort",
            "label": "effort",
            "type": "string"
          },
          {
            "id": "provider",
            "label": "provider",
            "type": "provider_text"
          },
          {
            "id": "model",
            "label": "model",
            "type": "model"
          },
          {
            "id": "permissions",
            "label": "permissions",
            "type": "string"
          }
        ],
        "outputs": [
          {
            "id": "exec-out",
            "label": "",
            "type": "execution"
          },
          {
            "id": "output",
            "label": "output",
            "type": "object"
          },
          {
            "id": "success",
            "label": "success",
            "type": "boolean"
          },
          {
            "id": "execution",
            "label": "execution",
            "type": "object"
          }
        ],
        "pinDefaults": {
          "permissions": "sandbox"
        },
        "functionName": "transform",
        "codeBody": "effort_text = str(effort or \"standard\").strip().lower().replace(\"_\", \" \").replace(\"-\", \" \")\nif effort_text in (\"quick\", \"quick search\", \"quick report\", \"fast\", \"fast search\", \"brief\", \"brief search\"):\n    effort_key = \"quick\"\nelif effort_text in (\"thorough\", \"thorough search\", \"thorough report\", \"deep\", \"deep research\", \"exhaustive\"):\n    effort_key = \"thorough\"\nelse:\n    effort_key = \"standard\"\n\nprofiles = {\n    \"quick\": {\n        \"effort\": \"quick\",\n        \"effort_preset\": \"Quick search\",\n        \"audience\": \"Technical decision-maker\",\n        \"quality_profile\": \"Fast, source-grounded answer with concise adversarial gap check\",\n        \"max_iterations\": 3,\n        \"deadline_minutes\": 8,\n        \"max_sources\": 12,\n        \"max_review_rounds\": 1,\n        \"source_policy\": \"Prefer primary or highly authoritative sources. Fetch before citing. Stop once the core answer is supported.\",\n        \"citation_policy\": \"Cite decisive claims and flag uncertainty instead of over-searching.\",\n        \"output_prefix\": \"reports/dp-quick-research\",\n        \"report_title\": \"Quick Research Brief\",\n        \"include_images\": False,\n    },\n    \"standard\": {\n        \"effort\": \"standard\",\n        \"effort_preset\": \"Standard search\",\n        \"audience\": \"Technical decision-maker\",\n        \"quality_profile\": \"Balanced research with adversarial review, source ledger, and evidence checks\",\n        \"max_iterations\": 6,\n        \"deadline_minutes\": 20,\n        \"max_sources\": 28,\n        \"max_review_rounds\": 2,\n        \"source_policy\": \"Prefer primary, recent, authoritative sources. Fetch before citing and compare at least one contrary source when useful.\",\n        \"citation_policy\": \"Every important factual claim needs a source id or an explicit limitation.\",\n        \"output_prefix\": \"reports/dp-standard-research\",\n        \"report_title\": \"Research Report\",\n        \"include_images\": True,\n    },\n    \"thorough\": {\n        \"effort\": \"thorough\",\n        \"effort_preset\": \"Thorough search\",\n        \"audience\": \"Technical decision-maker\",\n        \"quality_profile\": \"SOTA deep research with independent adversarial review, provenance, and strict evidence audit\",\n        \"max_iterations\": 10,\n        \"deadline_minutes\": 45,\n        \"max_sources\": 64,\n        \"max_review_rounds\": 3,\n        \"source_policy\": \"Prefer primary, recent, authoritative sources. Fetch before citing, triangulate important claims, and actively seek disconfirming evidence.\",\n        \"citation_policy\": \"Every non-obvious factual claim needs a source id or limitation. Distinguish primary evidence from commentary.\",\n        \"output_prefix\": \"reports/dp-thorough-research\",\n        \"report_title\": \"Deep Research Report\",\n        \"include_images\": True,\n    },\n}\n\nprofile = dict(profiles[effort_key])\nprovider_text = str(provider or \"\").strip()\nmodel_text = str(model or \"\").strip()\nif (provider_text and not model_text) or (model_text and not provider_text):\n    raise ValueError(\"provider and model must both be set, or both left blank for Gateway/Core defaults\")\nprofile[\"provider\"] = provider_text\nprofile[\"model\"] = model_text\n\nreturn profile"
      },
      "label": null,
      "icon": null,
      "headerColor": null,
      "inputs": [],
      "outputs": []
    },
