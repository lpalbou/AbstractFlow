      },
      "data": {
        "nodeType": "code",
        "label": "Should keep building?",
        "icon": "&#x1F9E9;",
        "headerColor": "#9B59B6",
        "inputs": [
          {
            "id": "loop_state",
            "label": "loop_state",
            "type": "object"
          },
          {
            "id": "max_rounds",
            "label": "max_rounds",
            "type": "number"
          },
          {
            "id": "permissions",
            "label": "permissions",
            "type": "string"
          }
        ],
        "outputs": [
          {
            "id": "output",
            "label": "output",
            "type": "object"
          },
          {
            "id": "success",
            "label": "success",
            "type": "boolean"
          },
          {
            "id": "execution",
            "label": "execution",
            "type": "object"
          }
        ],
        "pinDefaults": {
          "permissions": "sandbox"
        },
        "functionName": "transform",
        "codeBody": "state = loop_state or {}\ncompleted = int(state.get(\"rounds_completed\", 0) or 0)\nmax_rounds_value = max(1, int(max_rounds or 1))\npassed = bool(state.get(\"all_passed\"))\n# Environment failures (no executor on the host) are not fixable by the\n# builder: reprompting over them burns rounds for nothing. Stop early when\n# the ONLY failures left are environmental; keep going while any fixable\n# failure remains.\nfixable = state.get(\"failures\") or []\nenvironmental = state.get(\"environment_failures\") or []\nenvironment_blocked = completed > 0 and len(environmental) > 0 and len(fixable) == 0\n# Continue while the last round did NOT fully pass and we still have budget.\ncondition = (not passed) and (not environment_blocked) and completed < max_rounds_value\nreturn {\n    \"condition\": condition,\n    \"rounds_completed\": completed,\n    \"max_rounds\": max_rounds_value,\n    \"all_passed\": passed,\n}"
      },
      "label": null,
      "icon": null,
      "headerColor": null,
      "inputs": [],
      "outputs": []
    },
