      },
      "data": {
        "nodeType": "code",
        "label": "Compose builder prompt",
        "icon": "&#x1F9E9;",
        "headerColor": "#9B59B6",
        "inputs": [
          {
            "id": "request",
            "label": "request",
            "type": "string"
          },
          {
            "id": "workspace_root",
            "label": "workspace_root",
            "type": "string"
          },
          {
            "id": "loop_state",
            "label": "loop_state",
            "type": "object"
          },
