    {
      "id": "next_state",
      "type": "code",
      "position": {
        "x": 860,
        "y": 280
      },
      "data": {
        "nodeType": "code",
        "label": "Record verdict",
        "icon": "&#x1F9E9;",
        "headerColor": "#9B59B6",
        "inputs": [
          {
            "id": "verifier",
            "label": "verifier",
            "type": "object"
          },
          {
            "id": "round_index",
            "label": "round_index",
            "type": "number"
          },
          {
            "id": "permissions",
            "label": "permissions",
            "type": "string"
          }
        ],
        "outputs": [
          {
            "id": "output",
            "label": "output",
            "type": "object"
          },
          {
            "id": "success",
            "label": "success",
            "type": "boolean"
          },
          {
            "id": "execution",
            "label": "execution",
            "type": "object"
          }
        ],
        "pinDefaults": {
          "permissions": "sandbox"
        },
        "functionName": "transform",
        "codeBody": "verdict = verifier or {}\nnext_round = int(round_index or 0) + 1\nall_passed = bool(verdict.get(\"all_passed\"))\nfailures = verdict.get(\"failures\") or []\nif not isinstance(failures, list):\n    failures = [str(failures)]\nenv_failures = verdict.get(\"environment_failures\") or []\nif not isinstance(env_failures, list):\n    env_failures = [str(env_failures)]\n# Belt: if the verdict claims pass but a gate is false, do not trust the pass.\nif all_passed and not (verdict.get(\"builds\") and verdict.get(\"executes\") and verdict.get(\"matches\")):\n    all_passed = False\n    failures = failures + [\"verifier marked all_passed but a gate was false\"]\nif all_passed and env_failures:\n    all_passed = False\n    failures = failures + [\"verifier marked all_passed despite environment_failures\"]\nreturn {\n    \"rounds_completed\": next_round,\n    \"all_passed\": all_passed,\n    \"failures\": [str(f) for f in failures],\n    \"environment_failures\": [str(f) for f in env_failures],\n    \"last_verdict\": verdict,\n}"
      },
