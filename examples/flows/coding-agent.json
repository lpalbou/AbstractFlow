            "label": "permissions",
            "type": "string"
          }
        ],
        "outputs": [
          {
            "id": "output",
            "label": "output",
            "type": "string"
          },
          {
            "id": "success",
            "label": "success",
            "type": "boolean"
          },
          {
            "id": "execution",
            "label": "execution",
            "type": "object"
          }
        ],
        "pinDefaults": {
          "permissions": "sandbox"
        },
        "functionName": "transform",
        "codeBody": "req = str(request or \"\").strip()\nstate = loop_state or {}\ncompleted = int(state.get(\"rounds_completed\", 0) or 0)\nfailures = state.get(\"failures\") or []\nws = str(workspace_root or \"\").strip()\n\nparts = []\nparts.append(\"# Coding task\")\nparts.append(req)\nif ws:\n    parts.append(\"\")\n    parts.append(\"Work inside the workspace root: \" + ws)\nparts.append(\"\")\nparts.append(\"Delivery rules (verified mechanically after every round):\")\nparts.append(\"- Every produced file must live in the run workspace — never /tmp or another directory.\")\nparts.append(\"- For small web builds (games, pages, demos): prefer ONE self-contained entrypoint (index.html with inline script/styles) unless the task explicitly requires multiple files.\")\nparts.append(\"- If you do split files, the entrypoint must actually load every sibling (script src / link href) — an unreferenced file is a delivery failure, not a bonus.\")\nif completed > 0 and failures:\n    parts.append(\"\")\n    parts.append(\"# Previous attempt FAILED these checks — fix EXACTLY these, do not start over:\")\n    for i, f in enumerate(failures, 1):\n        parts.append(str(i) + \". \" + str(f))\n    parts.append(\"\")\n    parts.append(\"Make the minimal changes that resolve the specific failures above, then stop.\")\nelse:\n    parts.append(\"\")\n    parts.append(\"Write the code to satisfy the task. Create/edit files in the workspace. Keep it minimal and runnable.\")\nreturn \"\\n\".join(parts)"
      },
