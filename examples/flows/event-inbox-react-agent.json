          { "id": "temperature", "label": "temperature", "type": "number" },
          { "id": "mailbox", "label": "mailbox", "type": "string", "description": "Open event channel name. Producers post to it via the gateway emit_event command (scope=global, name=<mailbox>, durable=true)." },
          { "id": "task", "label": "task", "type": "string", "description": "Standing instruction applied to every burst of work." },
          { "id": "tools", "label": "tools", "type": "array", "description": "Tool allowlist for bursts (names resolved against the runtime tool registry). Empty = conversational resident." },
          { "id": "max_burst_cycles", "label": "max_burst_cycles", "type": "number", "description": "Cycle budget per burst before a forced #FALLBACK report." }
        ],
        "pinDefaults": {
          "temperature": 0.2,
