    {
      "id": "drain",
      "type": "code",
      "position": { "x": -1184.0, "y": 0.0 },
      "data": {
        "nodeType": "code",
        "label": "DRAIN MAILBOX",
        "icon": "&#x1F4E8;",
        "headerColor": "#2ECC71",
        "inputs": [
          { "id": "exec-in", "label": "", "type": "execution" },
          { "id": "inbox", "label": "inbox", "type": "array" },
          { "id": "cursor", "label": "cursor", "type": "number" },
          { "id": "in_burst", "label": "in_burst", "type": "boolean" },
          { "id": "burst_cycles", "label": "burst_cycles", "type": "number" },
          { "id": "max_burst", "label": "max_burst", "type": "number" }
        ],
        "outputs": [
          { "id": "exec-out", "label": "", "type": "execution" },
          { "id": "output", "label": "output", "type": "object" }
        ],
        "functionName": "transform",
        "code": "def transform(_input):\n    inbox = _input.get(\"inbox\") or []\n    try:\n        cursor = int(_input.get(\"cursor\") or 0)\n    except Exception:\n        cursor = 0\n    in_burst = bool(_input.get(\"in_burst\"))\n    try:\n        burst_cycles = int(_input.get(\"burst_cycles\") or 0)\n    except Exception:\n        burst_cycles = 0\n    try:\n        max_burst = int(_input.get(\"max_burst\") or 12)\n    except Exception:\n        max_burst = 12\n\n    fresh = []\n    new_cursor = cursor\n    for e in inbox:\n        if not isinstance(e, dict):\n            continue\n        try:\n            seq_i = int(e.get(\"seq\"))\n        except Exception:\n            continue\n        if seq_i > cursor:\n            fresh.append(e)\n            if seq_i > new_cursor:\n                new_cursor = seq_i\n\n    stop = False\n    lines = []\n    for e in fresh:\n        p = e.get(\"payload\") or {}\n        if not isinstance(p, dict):\n            p = {\"value\": p}\n        kind = str(p.get(\"kind\") or \"message\")\n        if kind == \"stop\":\n            stop = True\n        emitter = e.get(\"emitter\") or {}\n        if not isinstance(emitter, dict):\n            emitter = {}\n        src = str(p.get(\"from\") or emitter.get(\"client_id\") or \"unknown\")\n        prio = str(p.get(\"priority\") or \"normal\")\n        body = str(p.get(\"body\") or p.get(\"value\") or \"\")\n        lines.append(\"- [seq \" + str(e.get(\"seq\")) + \" | from \" + src + \" | kind \" + kind + \" | priority \" + prio + \" | at \" + str(e.get(\"emitted_at\") or \"?\") + \"] \" + body)\n\n    events_text = \"\\n\".join(lines) if lines else \"(no new events)\"\n\n    if stop:\n        mode = \"stop\"\n    elif fresh:\n        mode = \"work\"\n    elif in_burst and burst_cycles >= max_burst:\n        mode = \"flush\"\n    elif in_burst:\n        mode = \"work\"\n    else:\n        mode = \"park\"\n\n    return {\n        \"mode\": mode,\n        \"new_cursor\": new_cursor,\n        \"events_text\": events_text,\n        \"has_events\": bool(fresh),\n    }\n"
      }
    },
