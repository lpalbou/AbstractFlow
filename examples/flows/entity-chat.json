      "data": {
        "nodeType": "code",
        "label": "Degradation is visible (D3)",
        "icon": "&#x1F9E9;",
        "headerColor": "#9B59B6",
        "inputs": [
          {
            "id": "visit_out",
            "label": "visit_out",
            "type": "object"
          },
          {
            "id": "guard_died",
            "label": "guard_died",
            "type": "number"
          },
          {
            "id": "guard_error",
            "label": "guard_error",
            "type": "string"
          },
          {
            "id": "permissions",
            "label": "permissions",
            "type": "string"
          }
        ],
        "outputs": [
          {
            "id": "output",
            "label": "output",
            "type": "object"
          },
          {
            "id": "success",
            "label": "success",
            "type": "boolean"
          },
          {
            "id": "execution",
            "label": "execution",
            "type": "object"
          }
        ],
        "pinDefaults": {
          "permissions": "sandbox"
        },
        "functionName": "transform",
        "codeBody": "\n# D3 (wave-3 adversary B): the API surface must distinguish \"the entity said\n# nothing\" from \"the turn died\". Two independent degradation signals fold:\n# the visit's own marker (the turn died inside a lived visit — visit output\n# carries degraded/moment_error) and the visit child dying outright (the\n# guard fired; visit output may be absent entirely).\nvout = _input.get(\"visit_out\")\nif not isinstance(vout, dict):\n    vout = {}\ngd = _input.get(\"guard_died\")\nvd = vout.get(\"degraded\")\ndegraded = 1 if (gd == 1 or vd == 1) else 0\nerr = str(_input.get(\"guard_error\") or \"\") or str(vout.get(\"moment_error\") or \"\")\nreturn {\"degraded\": degraded, \"moment_error\": err}\n"
      },
      "label": null,
      "icon": null,
      "headerColor": null,
      "inputs": [],
      "outputs": []
