      "data": {
        "nodeType": "code",
        "label": "Session state (durable history fold)",
        "icon": "&#x1F9E9;",
        "headerColor": "#9B59B6",
        "inputs": [
          {
            "id": "state",
            "label": "state",
            "type": "object"
          },
          {
            "id": "context",
            "label": "context",
            "type": "object"
