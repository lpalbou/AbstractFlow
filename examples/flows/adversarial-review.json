    {
      "id": "merge",
      "type": "code",
      "position": {
        "x": 300,
        "y": 200
      },
      "data": {
        "nodeType": "code",
        "label": "Merge + rank findings",
        "icon": "&#x1F9E9;",
        "headerColor": "#9B59B6",
        "inputs": [
          {
            "id": "correctness",
            "label": "correctness",
            "type": "object"
          },
          {
            "id": "design",
            "label": "design",
            "type": "object"
          },
          {
            "id": "requirements_fit",
            "label": "requirements_fit",
            "type": "object"
          },
          {
            "id": "permissions",
            "label": "permissions",
            "type": "string"
          }
        ],
        "outputs": [
          {
            "id": "output",
            "label": "output",
            "type": "object"
          },
          {
            "id": "success",
            "label": "success",
            "type": "boolean"
          },
          {
            "id": "execution",
            "label": "execution",
            "type": "object"
          }
        ],
        "pinDefaults": {
          "permissions": "sandbox"
        },
        "functionName": "transform",
        "codeBody": "def _findings(obj, lens_name):\n    obj = obj or {}\n    out = []\n    for f in (obj.get(\"findings\") or []):\n        if not isinstance(f, dict):\n            continue\n        sev = str(f.get(\"severity\") or \"P2\").upper()\n        if sev not in (\"P0\", \"P1\", \"P2\", \"P3\"):\n            sev = \"P2\"\n        out.append({\n            \"severity\": sev,\n            \"lens\": lens_name,\n            \"title\": str(f.get(\"title\") or \"\").strip(),\n            \"detail\": str(f.get(\"detail\") or \"\").strip(),\n        })\n    return out\n\nmerged = _findings(correctness, \"correctness\") + _findings(design, \"design\") + _findings(requirements_fit, \"requirements-fit\")\norder = {\"P0\": 0, \"P1\": 1, \"P2\": 2, \"P3\": 3}\nmerged.sort(key=lambda f: order.get(f[\"severity\"], 2))\nblocking = sum(1 for f in merged if f[\"severity\"] in (\"P0\", \"P1\"))\np0 = sum(1 for f in merged if f[\"severity\"] == \"P0\")\nif p0 > 0:\n    verdict = \"block\"\nelif blocking > 0:\n    verdict = \"revise\"\nelse:\n    verdict = \"pass\"\nsummary = str(len(merged)) + \" findings across 3 lenses; \" + str(blocking) + \" blocking (\" + str(p0) + \" P0).\"\nreturn {\n    \"findings\": merged,\n    \"blocking_count\": blocking,\n    \"verdict\": verdict,\n    \"summary\": summary,\n}"
      },
      "label": null,
      "icon": null,
      "headerColor": null,
      "inputs": [],
      "outputs": []
    },
