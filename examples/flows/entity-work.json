    {
      "id": "wcond",
      "type": "code",
      "position": {
        "x": 640,
        "y": 620
      },
      "data": {
        "nodeType": "code",
        "label": "Task done or budget spent?",
        "icon": "&#x1F9E9;",
        "headerColor": "#9B59B6",
        "inputs": [
          {
            "id": "state",
            "label": "state",
            "type": "object"
          },
          {
            "id": "max_ticks",
            "label": "max_ticks",
            "type": "number"
          },
          {
            "id": "permissions",
            "label": "permissions",
            "type": "string"
          }
        ],
        "outputs": [
          {
            "id": "output",
            "label": "output",
            "type": "object"
          },
          {
            "id": "success",
            "label": "success",
            "type": "boolean"
          },
          {
            "id": "execution",
            "label": "execution",
            "type": "object"
          }
        ],
        "pinDefaults": {
          "permissions": "sandbox"
        },
        "functionName": "transform",
        "codeBody": "\nstate = _input.get(\"state\") or {}\nif not isinstance(state, dict):\n    state = {}\n# PURE-NODE LAW: code nodes are volatile (re-evaluated per data pull), so\n# inputs must NEVER be mutated in place — copy before writing.\nstate = dict(state)\nmax_ticks = _input.get(\"max_ticks\")\nif not isinstance(max_ticks, int) or max_ticks < 1:\n    max_ticks = 12\nticks = state.get(\"turn_count\")\nif not isinstance(ticks, int):\n    ticks = 0\ndone = state.get(\"task_done\")\nif not isinstance(done, int):\n    done = 0\nkeep = 1\nif done == 1 and ticks > 0:\n    # A done-flag with zero turns THIS session is stale (a guard fallback\n    # or prior-phase residue) — never let it consume a task unlived.\n    keep = 0\nif ticks >= max_ticks:\n    keep = 0\nreturn {\"condition\": keep}\n"
      },
      "label": null,
      "icon": null,
      "headerColor": null,
      "inputs": [],
      "outputs": []
    },
