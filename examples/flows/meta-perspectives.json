        "pinDefaults": {
          "permissions": "sandbox"
        },
        "functionName": "transform",
        "codeBody": "q = str(prompt or \"\").strip()\nparts = []\nparts.append(\"Before answering, decide how this question should be LOOKED AT. Pick the 3 most revealing, mutually distinct angles for THIS question — not generic roles.\")\nparts.append(\"\")\nparts.append(\"# Question\")\nparts.append(q)\nparts.append(\"\")\nparts.append(\"Examples of what an angle can be (pick what fits THIS question): a discipline (economist, biologist), a stance (skeptic, advocate), a timescale (short-term, long-term), a stakeholder (user, operator), a method (empirical, theoretical). For each angle give: name, and focus = the one question this angle presses on.\")\nreturn \"\\n\".join(parts)"
      },
      "label": null,
      "icon": null,
      "headerColor": null,
      "inputs": [],
      "outputs": []
    },
