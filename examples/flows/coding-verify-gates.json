    {
      "id": "verifier_prompt",
      "type": "code",
      "position": {
        "x": -240,
        "y": 40
      },
      "data": {
        "nodeType": "code",
        "label": "Compose verifier task",
        "icon": "&#x1F9E9;",
        "headerColor": "#9B59B6",
        "inputs": [
          {
            "id": "request",
            "label": "request",
            "type": "string"
          },
          {
            "id": "workspace_root",
            "label": "workspace_root",
            "type": "string"
          },
          {
            "id": "build_command",
            "label": "build_command",
            "type": "string"
          },
          {
            "id": "run_command",
            "label": "run_command",
            "type": "string"
          },
          {
            "id": "permissions",
            "label": "permissions",
            "type": "string"
          }
        ],
        "outputs": [
          {
            "id": "output",
            "label": "output",
            "type": "string"
          },
          {
            "id": "success",
            "label": "success",
            "type": "boolean"
          },
          {
            "id": "execution",
            "label": "execution",
            "type": "object"
          }
        ],
        "pinDefaults": {
          "permissions": "sandbox"
        },
        "functionName": "transform",
        "codeBody": "req = str(request or \"\").strip()\nws = str(workspace_root or \"\").strip()\nbuild_cmd = str(build_command or \"\").strip()\nrun_cmd = str(run_command or \"\").strip()\n\nparts = []\nparts.append(\"You are an INDEPENDENT code verifier. Do NOT edit any code. Run the checks and report a structured verdict.\")\nparts.append(\"\")\nparts.append(\"## The task the code was meant to satisfy\")\nparts.append(req)\nif ws:\n    parts.append(\"\")\n    parts.append(\"Workspace root: \" + ws)\nparts.append(\"\")\nparts.append(\"## Gate 1 - BUILDS\")\nif build_cmd:\n    parts.append(\"Run this build command with execute_command and record whether it succeeds: \" + build_cmd)\nelse:\n    parts.append(\"Detect the stack (list_files) and run the appropriate build/compile/syntax-check command with execute_command. For interpreted languages with no build step, treat import/syntax check as the build (e.g. python -m py_compile).\")\nparts.append(\"On failure, capture the exact error output in build_error.\")\nparts.append(\"\")\nparts.append(\"## Gate 2 - EXECUTES\")\nif run_cmd:\n    parts.append(\"Run this command with execute_command and record whether it runs without error: \" + run_cmd)\nelse:\n    parts.append(\"Run the program (or its tests / a smoke invocation) with execute_command. Capture any traceback/runtime error in run_error. For web/browser artifacts you cannot fully run, say so honestly in run_error and set executes=false only if there is a real error, true if the entrypoint loads.\")\nparts.append(\"\")\nparts.append(\"## Gate 3 - MATCHES THE ASK\")\nparts.append(\"Use analyze_code on the produced source files to get the structure (functions/classes) and diagnostics, then judge whether the code STRUCTURE plausibly satisfies the task above. Put concrete gaps in mismatch (e.g. 'task asked for function X, not present').\")\nparts.append(\"\")\nparts.append(\"## Verdict\")\nparts.append(\"Set all_passed=true ONLY if builds AND executes AND matches are all true. Put one specific, actionable failure line per failed gate into failures[] (the exact error, not 'it failed'). summary: one sentence.\")\nreturn \"\\n\".join(parts)"
      },
      "label": null,
      "icon": null,
      "headerColor": null,
      "inputs": [],
      "outputs": []
    },
