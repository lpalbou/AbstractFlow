            "id": "permissions",
            "label": "permissions",
            "type": "string"
          }
        ],
        "outputs": [
          {
            "id": "exec-out",
            "label": "",
            "type": "execution"
          },
          {
            "id": "updates",
            "label": "updates",
            "type": "object"
          }
        ],
        "pinDefaults": {
          "permissions": "sandbox",
          "entry_text": "--- step {{n}} ---\nTHOUGHT: {{thought}}\nACTIONS: {{calls}}\nOBSERVATIONS:\n{{obs}}",
          "trim_marker": "[...earlier steps of this cycle trimmed...]\n",
          "max_chars": 0
        },
        "functionName": "transform",
        "codeBody": "n = int(step or 0) + 1\nentry = str(entry_text or \"\")\nentry = entry.replace(\"{{n}}\", str(n))\nentry = entry.replace(\"{{thought}}\", str(thought or \"\").strip())\nentry = entry.replace(\"{{calls}}\", str(calls_text or \"\"))\nentry = entry.replace(\"{{obs}}\", str(observations or \"\"))\ntrace = str(transcript or \"\")\ntrace = trace + (\"\\n\" if trace else \"\") + entry\ntry:\n    cap = int(max_chars or 0)\nexcept Exception:\n    cap = 0\nif cap > 0 and len(trace) > cap:\n    trace = str(trim_marker or \"\") + trace[len(trace) - cap:]\nreturn {\"updates\": {\"transcript\": trace, \"step\": n}}"
      },
      "label": null,
      "icon": null,
      "headerColor": null,
      "inputs": [],
      "outputs": []
    },
