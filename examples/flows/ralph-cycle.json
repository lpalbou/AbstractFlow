            "label": "",
            "type": "execution"
          },
          {
            "id": "prompt",
            "label": "prompt",
            "type": "string"
          }
        ],
        "pinDefaults": {
          "permissions": "sandbox",
          "trace_header": "# THIS CYCLE'S STEPS SO FAR",
          "first_step_text": "This is the first step of the cycle. Begin with the protocol above.",
          "closing_text": "Take the next step now: either call tools, or — if this cycle's work is complete — answer with the summary and make no tool calls."
        },
        "functionName": "transform",
        "codeBody": "n = int(step or 0) + 1\nparts = [str(task_prompt or \"\")]\ntrace = str(transcript or \"\").strip()\nif trace:\n    parts.append(str(trace_header or \"\") + \"\\n\" + trace)\nelse:\n    parts.append(str(first_step_text or \"\"))\nparts.append(str(closing_text or \"\").replace(\"{{n}}\", str(n)))\nreturn {\"prompt\": \"\\n\\n\".join(parts)}"
      },
      "label": null,
      "icon": null,
      "headerColor": null,
      "inputs": [],
      "outputs": []
    },
