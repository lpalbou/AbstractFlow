          }
        ],
        "pinDefaults": {
          "permissions": "sandbox"
        },
        "functionName": "transform",
        "codeBody": "try:\n    steps = int(max_steps or 0)\nexcept Exception:\n    steps = 0\nif steps < 1:\n    steps = 1\nif steps > 30:\n    steps = 30\nreturn {\"updates\": {\"step\": 0, \"step_done\": False, \"transcript\": \"\", \"summary\": \"\",\n                    \"max_steps\": steps}}"
      },
