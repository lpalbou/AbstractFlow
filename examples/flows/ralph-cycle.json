        "icon": "&#x1F9E9;",
        "headerColor": "#9B59B6",
        "inputs": [
          {
            "id": "exec-in",
            "label": "",
            "type": "execution"
          },
          {
            "id": "max_steps",
            "label": "max_steps",
            "type": "number"
