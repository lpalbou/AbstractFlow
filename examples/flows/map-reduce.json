        "functionName": "transform",
        "codeBody": "instr = str(reduce_instruction or \"Synthesize the results into one coherent summary.\").strip()\nitems = results or []\nparts = [instr, \"\", \"## Per-item results (\" + str(len(items)) + \")\"]\n# ADR-0026: the reducer reads every per-item result WHOLE.\nfor r in items:\n    if isinstance(r, dict):\n        parts.append(\"- [\" + str(r.get(\"index\")) + \"] \" + str(r.get(\"result\", \"\")))\n    else:\n        parts.append(\"- \" + str(r))\nreturn \"\\n\".join(parts)"
      },
