      "data": {
        "nodeType": "code",
        "label": "Derive effort settings",
        "icon": "&#x25A1;",
        "headerColor": "#3498DB",
        "inputs": [
          {
            "id": "exec-in",
            "label": "",
            "type": "execution"
          },
          {
            "id": "effort",
            "label": "effort",
            "type": "string"
          },
          {
            "id": "provider",
            "label": "provider",
            "type": "provider_text"
          },
          {
            "id": "model",
            "label": "model",
            "type": "model"
          },
          {
            "id": "permissions",
            "label": "permissions",
            "type": "string"
          }
        ],
        "outputs": [
          {
            "id": "exec-out",
            "label": "",
            "type": "execution"
          },
          {
            "id": "output",
            "label": "output",
            "type": "object"
          },
