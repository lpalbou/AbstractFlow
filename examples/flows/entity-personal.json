            "label": "permissions",
            "type": "string"
          }
        ],
        "outputs": [
          {
            "id": "output",
            "label": "output",
            "type": "object"
          },
          {
            "id": "success",
            "label": "success",
            "type": "boolean"
          },
          {
            "id": "execution",
            "label": "execution",
            "type": "object"
          }
        ],
        "pinDefaults": {
          "permissions": "sandbox"
        },
        "functionName": "transform",
        "codeBody": "\nstate = _input.get(\"state\") or {}\nif not isinstance(state, dict):\n    state = {}\n# PURE-NODE LAW: code nodes are volatile (re-evaluated per data pull), so\n# inputs must NEVER be mutated in place — copy before writing.\nstate = dict(state)\nmax_ticks = _input.get(\"max_ticks\")\nif not isinstance(max_ticks, int) or max_ticks < 1:\n    max_ticks = 3\nticks = state.get(\"turn_count\")\nif not isinstance(ticks, int):\n    ticks = 0\nkeep = 1\nif ticks >= max_ticks:\n    keep = 0\nreturn {\"condition\": keep}\n"
      },
      "label": null,
      "icon": null,
      "headerColor": null,
