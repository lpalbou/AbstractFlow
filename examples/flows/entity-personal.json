      },
      "data": {
        "nodeType": "code",
        "label": "Day budget",
        "icon": "&#x1F9E9;",
        "headerColor": "#9B59B6",
        "inputs": [
          {
            "id": "state",
            "label": "state",
            "type": "object"
          },
          {
            "id": "max_ticks",
            "label": "max_ticks",
            "type": "number"
          },
          {
