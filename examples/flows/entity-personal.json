    {
      "id": "drive_cue",
      "type": "code",
      "position": {
        "x": 800,
        "y": 180
      },
      "data": {
        "nodeType": "code",
        "label": "Compose the cue",
        "icon": "&#x1F9E9;",
        "headerColor": "#9B59B6",
        "inputs": [
          {
            "id": "items",
            "label": "items",
            "type": "array"
          },
          {
            "id": "permissions",
            "label": "permissions",
            "type": "string"
          }
        ],
        "outputs": [
          {
            "id": "output",
            "label": "output",
            "type": "object"
          },
          {
            "id": "success",
            "label": "success",
            "type": "boolean"
          },
          {
            "id": "execution",
            "label": "execution",
            "type": "object"
          }
        ],
        "pinDefaults": {
          "permissions": "sandbox"
        },
        "functionName": "transform",
        "codeBody": "\n# The day-open cue: what is ALIVE for the entity (open questions, interests,\n# unresolved threads) — read from the engine, offered as the self-tick\n# stimulus. Absent drives = an honest open day.\n# DREAMS carry their record id (adversary A, P2-2 + runtime c5215): a dream\n# is the entity's to DISPOSE (confirm|reject via the ```tend fence), and\n# disposal needs the addressable id — an unnamed dream is undischargeable.\nitems = _input.get(\"items\")\nif not isinstance(items, list):\n    items = []\nlines = []\nhas_dream = 0\nfor it in items[:5]:\n    if isinstance(it, dict):\n        kind = str(it.get(\"kind\") or \"\")\n        rid = str(it.get(\"record_id\") or \"\")\n        if kind == \"dream\" and rid:\n            # A dream line must be HUMAN words (wave-4 adversary E, F3):\n            # dream TITLES are mechanical bridge strings (\"'Diary entry…'\n            # beside 'Diary entry…'\") — feeding them back as the day cue\n            # made the entity's own time recursive boilerplate. The digest's\n            # first clause carries the dream's actual content.\n            d = str(it.get(\"digest\") or it.get(\"title\") or \"\").strip().replace(\"\\n\", \" \")\n            cut = d.find(\". \")\n            clause = d[:cut + 1] if 0 < cut < 140 else d[:140]\n            lines.append(\"- an unresolved dream [\" + rid + \"]: \" + clause)\n            has_dream = 1\n            continue\n        t = str(it.get(\"title\") or it.get(\"digest\") or it.get(\"text\") or \"\").strip()\n        if t:\n            lines.append(\"- \" + t)\n    elif isinstance(it, str) and it.strip():\n        lines.append(\"- \" + it.strip())\nif lines:\n    cue = \"What is alive for you today:\\n\" + \"\\n\".join(lines) + \"\\n\\nFollow one of these — or what they awaken.\"\n    if has_dream == 1:\n        cue = cue + (\"\\nA dream above is yours to judge by waking evidence: dispose it in your\"\n                     \" tend fence — `dispose: <dream id> confirm|reject -- reason: <your verdict>`.\")\nelse:\n    cue = \"\"\nreturn {\"cue\": cue}\n"
      },
      "label": null,
      "icon": null,
      "headerColor": null,
      "inputs": [],
      "outputs": []
    },
