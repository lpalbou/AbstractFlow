    {
      "id": "build_prompt",
      "type": "code",
      "position": {
        "x": -740,
        "y": -340
      },
      "data": {
        "nodeType": "code",
        "label": "Compose extractor prompt",
        "icon": "&#x1F9E9;",
        "headerColor": "#9B59B6",
        "inputs": [
          {
            "id": "source_text",
            "label": "source_text",
            "type": "string"
          },
          {
            "id": "fields_spec",
            "label": "fields_spec",
            "type": "object"
          },
          {
            "id": "attempt_no",
            "label": "attempt_no",
            "type": "number"
          },
          {
            "id": "validation_errors",
            "label": "validation_errors",
            "type": "array"
          },
          {
            "id": "permissions",
            "label": "permissions",
            "type": "string"
          }
        ],
        "outputs": [
          {
            "id": "output",
            "label": "output",
            "type": "string"
          },
          {
            "id": "success",
            "label": "success",
            "type": "boolean"
          },
          {
            "id": "execution",
            "label": "execution",
            "type": "object"
          }
        ],
        "pinDefaults": {
          "permissions": "sandbox"
        },
        "functionName": "transform",
        "codeBody": "src = str(source_text or \"\").strip()\nschema = fields_spec or {}\nattempt = int(attempt_no or 0)\nerrors = validation_errors or []\nparts = []\nparts.append(\"Extract structured data from the SOURCE below and return ONLY a JSON object that conforms to the SCHEMA.\")\nparts.append(\"\")\nparts.append(\"## Schema (JSON Schema)\")\nparts.append(str(schema) if schema else \"(no schema provided; infer a flat object of the key facts)\")\nparts.append(\"\")\nparts.append(\"## Source\")\nparts.append(src)\nif attempt > 0 and errors:\n    parts.append(\"\")\n    parts.append(\"## Your previous output FAILED validation - fix EXACTLY these and re-output the full object:\")\n    i = 0\n    for e in errors:\n        i = i + 1\n        parts.append(str(i) + \". \" + str(e))\nparts.append(\"\")\nparts.append(\"Return the JSON object only. Do not invent values not supported by the source; use null (or omit optional keys) when the source does not state a value.\")\nreturn \"\\n\".join(parts)"
      },
      "label": null,
      "icon": null,
      "headerColor": null,
      "inputs": [],
      "outputs": []
