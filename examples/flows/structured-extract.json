    {
      "id": "validate",
      "type": "code",
      "position": {
        "x": -360,
        "y": 420
      },
      "data": {
        "nodeType": "code",
        "label": "Validate against schema",
        "icon": "&#x1F9E9;",
        "headerColor": "#9B59B6",
        "inputs": [
          {
            "id": "extracted",
            "label": "extracted",
            "type": "any"
          },
          {
            "id": "fields_spec",
            "label": "fields_spec",
            "type": "object"
          },
          {
            "id": "attempt_no",
            "label": "attempt_no",
            "type": "number"
          },
          {
            "id": "permissions",
            "label": "permissions",
            "type": "string"
          }
        ],
        "outputs": [
          {
            "id": "output",
            "label": "output",
            "type": "object"
          },
          {
            "id": "success",
            "label": "success",
            "type": "boolean"
          },
          {
            "id": "execution",
            "label": "execution",
            "type": "object"
          }
        ],
        "pinDefaults": {
          "permissions": "sandbox"
        },
        "functionName": "transform",
        "codeBody": "def _type_ok(val, t):\n    if t == \"string\":\n        return isinstance(val, str)\n    if t == \"number\":\n        return isinstance(val, (int, float)) and not isinstance(val, bool)\n    if t == \"integer\":\n        return isinstance(val, int) and not isinstance(val, bool)\n    if t == \"boolean\":\n        return isinstance(val, bool)\n    if t == \"array\":\n        return isinstance(val, list)\n    if t == \"object\":\n        return isinstance(val, dict)\n    if t == \"null\":\n        return val is None\n    return True\n\nobj = extracted if isinstance(extracted, dict) else None\nerrors = []\nif obj is None:\n    return {\"valid\": False, \"errors\": [\"extractor did not return a structured object\"], \"data\": {}, \"attempt\": int(attempt_no or 0) + 1}\nschema = fields_spec if isinstance(fields_spec, dict) else {}\nprops = schema.get(\"properties\")\nrequired = schema.get(\"required\")\nif isinstance(required, list):\n    for key in required:\n        if key not in obj or obj.get(key) is None:\n            errors.append(\"missing required key: \" + str(key))\nif isinstance(props, dict):\n    for key in props:\n        spec = props.get(key)\n        if key in obj and obj.get(key) is not None and isinstance(spec, dict) and spec.get(\"type\"):\n            t = spec.get(\"type\")\n            if not _type_ok(obj.get(key), t):\n                errors.append(\"key '\" + str(key) + \"' should be \" + str(t))\nreturn {\n    \"valid\": len(errors) == 0,\n    \"errors\": errors,\n    \"data\": obj,\n    \"attempt\": int(attempt_no or 0) + 1,\n}"
      },
      "label": null,
      "icon": null,
      "headerColor": null,
      "inputs": [],
      "outputs": []
    },
