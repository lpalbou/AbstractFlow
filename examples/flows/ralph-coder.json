        "pinDefaults": {
          "permissions": "sandbox",
          "died_text": "The ralph coding run did not finish: {{error}}\n\nThe workspace and its progress file hold whatever the completed cycles did; the run's own trace holds the failing step.",
          "unknown_error_text": "the child run ended without producing a report"
        },
        "functionName": "transform",
        "codeBody": "rep = report if isinstance(report, str) else \"\"\nok = bool(child_success)\ndied = child_result if isinstance(child_result, dict) else {}\nif not rep.strip():\n    err = str(died.get(\"error\") or \"\").strip()\n    rep = str(died_text or \"\").replace(\n        \"{{error}}\", err if err else str(unknown_error_text or \"\"))\n    ok = False\nreturn {\n    \"response\": rep,\n    \"ok\": ok,\n    \"meta\": {\"branch\": \"\",\n             \"stopped_reason\": stopped_reason if isinstance(stopped_reason, str) else \"\",\n             \"cycles_used\": cycles_used if isinstance(cycles_used, (int, float)) else 0,\n             \"orchestration\": \"ralph\"},\n}"
      },
